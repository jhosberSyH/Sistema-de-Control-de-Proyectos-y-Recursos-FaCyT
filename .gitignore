# ---------------------------------------------------------------
# Variables de entorno (nunca se suben; la plantilla es .env.example)
# ---------------------------------------------------------------
.env
.env.*
!.env.example

# ---------------------------------------------------------------
# Python (backend)
# ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ---------------------------------------------------------------
# Node, Vite y Playwright (frontend)
# ---------------------------------------------------------------
node_modules/
dist/
dist-ssr/
*.local
.vite/
coverage/
test-results/
playwright-report/
blob-report/
playwright/.cache/
.eslintcache
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------------------------------------------
# Editores y sistema operativo
# ---------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------
# Claude Code: se suben las skills del proyecto, no las notas de sesión
# ---------------------------------------------------------------
.claude/handoff/
.claude/settings.local.json

# ---------------------------------------------------------------
# Documentación: archivos intermedios con los que se generó el Google Doc
# (se conservan en local; se regeneran con la skill documento-de-requisitos)
# ---------------------------------------------------------------
docs/requisitos/generacion/*
!docs/requisitos/generacion/.gitkeep

# Bases de datos locales SQLite
*.db
*.sqlite
*.sqlite3

# ---------------------------------------------------------------
# Configuración local de Agentes y MCP (contiene secretos/tokens)
# ---------------------------------------------------------------
.agents/
.agent/
_agents/
_agent/
*mcp_config*.json
