# Variables del frontend (Vite). Solo las que empiezan con VITE_ llegan al navegador.
# Detalle: frontend/plan_frontend.md, sección 3.

# Datos ficticios (mock) con Mock Service Worker.
#   true  = la app responde con los datos de src/testing/mocks (no hace falta backend)
#   false = las peticiones a /api van al backend real
# Con "npm run dev:mock" se carga .env.mock, que ya trae true.
VITE_ENABLE_API_MOCKING=false
