# Copia este archivo como .env y completa los valores.
# No subas el .env al repositorio. Detalle de cada variable: README, sección 11.

# --- Base de datos local (servicio db) ---
POSTGRES_DB=control_proyectos
POSTGRES_USER=cpq
# Cambia esta clave y pon la misma en DATABASE_URL
POSTGRES_PASSWORD=cambia-esta-clave

# --- API (servicio api) ---
# Local sin Docker:  cambia db por localhost
# Supabase:          cadena del Session pooler (puerto 5432) con ?sslmode=require
DATABASE_URL=postgresql+psycopg://cpq:cambia-esta-clave@db:5432/control_proyectos
APP_ENV=development
APP_TIMEZONE=America/Caracas
API_HOST=0.0.0.0
API_PORT=8000
FORWARDED_ALLOW_IPS=*

# Sesiones y CSRF
SESSION_COOKIE_NAME=__Host-sesion
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8
# Lista en formato JSON (pydantic-settings no acepta texto plano para listas)
ALLOWED_ORIGINS=["http://localhost:8080"]

# --- Web (servicio web: Nginx) ---
WEB_PORT=8080
API_UPSTREAM=http://api:8000

# --- Archivos: cotizaciones de gastos ---
# local = carpeta del servidor (desarrollo); supabase = Supabase Storage (producción)
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./var/archivos
# Solo con supabase. El bucket debe ser PRIVADO; la clave de servicio nunca va al frontend.
# SUPABASE_URL=https://<proyecto>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=cotizaciones
MAX_COTIZACION_MB=10

# --- Pruebas contra PostgreSQL (backend/tests/conftest.py). La base se BORRA y se recrea ---
# TEST_DATABASE_URL=postgresql+psycopg://cpq:cambia-esta-clave@localhost:5432/cpq_test

# --- Solo Windows sin Docker: carpeta de Pango para WeasyPrint ---
# WEASYPRINT_DLL_DIRECTORIES=
